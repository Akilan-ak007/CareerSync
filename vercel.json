    { "source": "/students", "destination": "/index.html" },
    { "source": "/students/(.*)", "destination": "/index.html" },
    { "source": "/companies", "destination": "/index.html" },
    { "source": "/company-approvals", "destination": "/index.html" },
    { "source": "/placement-team", "destination": "/index.html" },
    { "source": "/offers", "destination": "/index.html" },
    { "source": "/audit-logs", "destination": "/index.html" },
    { "source": "/reports", "destination": "/index.html" }
